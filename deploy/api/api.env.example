# Production settings for the API. install.sh copies this to /etc/sample-users-api/api.env
# (readable only by root and the service user). Fill in every CHANGE_ME, then re-run install.sh.

DATABASE_URL=postgresql://sample_users:CHANGE_ME@localhost:5432/users_db

# openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=60

# The web app is served from the same origin via nginx, so CORS is only needed for
# other origins. List your site's URL here if you call the API from elsewhere.
CORS_ORIGINS=https://CHANGE_ME.example.com

# Cookie auth: only send the cookie over HTTPS. Set false only if the site is plain HTTP.
AUTH_COOKIE_SECURE=true

# Card encryption. Generate a key with:  uv run python -m app.keygen 1
# On AWS, use CARD_KEY_PROVIDER=kms with CARD_KMS_KEY_ID instead (see the main README).
CARD_KEY_PROVIDER=env
CARD_ENCRYPTION_KEYS=CHANGE_ME

# Deliberately NOT set in production: no default user with a known password.
# DEFAULT_USER_PASSWORD=
