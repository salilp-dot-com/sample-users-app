# Repo-wide ignores. api/.gitignore and web/.gitignore add app-specific rules.

# --- Secrets and local config ---------------------------------------------------
# Real env files hold passwords and encryption keys. Templates stay tracked.
.env
.env.*
!.env.example
*.local
# Private keys, certificates and credential files
*.pem
*.key
*.p12
*.pfx
credentials.json
# Claude Code's per-user settings (the shared .claude/settings.json is fine to commit)
.claude/settings.local.json

# --- Build and package output ---------------------------------------------------
# scripts/package.sh output (release tarballs + SHA256SUMS)
/dist/
*.tar.gz
SHA256SUMS
# Version stamped into packages at build time (the source of truth is version.txt)
api/VERSION

# --- Python ---------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# --- Node -----------------------------------------------------------------------
node_modules/
coverage/
.vite/
*.tsbuildinfo
npm-debug.log*

# --- Logs and temporary files ---------------------------------------------------
*.log
logs/
tmp/
*.tmp
*.bak
*.swp
*~

# --- OS -------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini

# --- Editors and IDEs -----------------------------------------------------------
# Keep shared VS Code recommendations/settings if you add them; ignore the rest.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.code-workspace
