# Copy to .env for local development:  cp .env.example .env
DATABASE_URL=postgresql://postgres:Password123!@localhost:5433/users_db
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5173
# Cookie auth: send the cookie over HTTPS only. Set true when deployed.
AUTH_COOKIE_SECURE=false

# --- Card encryption: local -------------------------------------------------
# Generate with:  uv run python -m app.keygen 1
CARD_KEY_PROVIDER=env
CARD_ENCRYPTION_KEYS=1:<base64 32-byte key>

# --- Card encryption: AWS (set these in the task definition / secrets, not here)
# CARD_KEY_PROVIDER=kms
# CARD_KMS_KEY_ID=alias/sample-users-card-key
# AWS_REGION=us-east-1
# Generate with (CARD_KEY_PROVIDER=kms):  uv run python -m app.keygen 1
# CARD_ENCRYPTION_KEYS=1:<base64 KMS-encrypted data key>

# --- Default user (local dev only) --------------------------------------------
# Migration 0002 inserts this user once, only if DEFAULT_USER_PASSWORD is set.
# Leave it unset in production so no account with a known password exists there.
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=ChangeMe-dev-only-123
